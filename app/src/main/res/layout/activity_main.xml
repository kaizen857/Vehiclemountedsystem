<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_dark"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Left Tab Rail (Sleek Modern Car Dock) -->
    <LinearLayout
        android:id="@+id/tabRail"
        android:layout_width="@dimen/shell_tab_rail_width"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingTop="@dimen/shell_tab_rail_vertical_padding"
        android:paddingBottom="@dimen/shell_tab_rail_vertical_padding"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_horizontal"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tabOverview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_overview"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabMinimal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_minimal"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabNavigation"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_navigation"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabSensors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_sensors"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabHvac"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_hvac"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabMedia"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_media"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabControls"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_controls"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="@dimen/shell_tab_spacing" />

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tab_settings"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/shell_tab_text_size"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Right Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/shell_content_gap">

        <!-- Header -->
        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_overview"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/shell_title_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="8dp" />

        <!-- Content Host -->
        <FrameLayout
            android:id="@+id/pageHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:elevation="12dp">

            <!-- Placeholder for default overview page content -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/placeholder_overview"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/shell_placeholder_text_size" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>