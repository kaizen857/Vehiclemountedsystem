<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageControlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/page_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/controlPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/page_section_gap"
            android:text="@string/page_control_badge"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/page_title_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/page_card_padding"
            android:layout_marginBottom="@dimen/page_section_gap">

            <TextView
                android:id="@+id/controlDemoNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/control_demo_notice"
                android:textColor="@color/accent_amber"
                android:textSize="@dimen/page_status_text_size" />

            <TextView
                android:id="@+id/controlDemoSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_micro_gap"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/page_status_text_size"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/page_card_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_window_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/windowFrontLeftState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/windowFrontLeftAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_section_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/control_window_action"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_mirror_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/mirrorLeftState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/mirrorLeftAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_section_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/control_mirror_action"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/page_section_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_seat_heat_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/seatHeatState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/seatHeatAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_section_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/control_seat_heat_action"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/control_lock_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/lockDemoState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lockDemoAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_section_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/control_lock_action"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>