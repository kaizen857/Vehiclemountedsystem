<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dashboardPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_dashboard_badge"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/page_title_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_section_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="2"
                android:background="@color/card_panel_alt_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_speed"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/dashboardSpeedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_speed_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dashboardImuValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_panel_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/page_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/page_label_gear"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/page_label_text_size" />

                    <TextView
                        android:id="@+id/dashboardGearValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_cyan"
                        android:textSize="@dimen/page_value_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:background="@color/card_panel_bg"
                    android:orientation="vertical"
                    android:padding="@dimen/page_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/page_label_battery"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/page_label_text_size" />

                    <TextView
                        android:id="@+id/dashboardBatteryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/page_value_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dashboardPowerValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:padding="@dimen/page_card_padding"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/page_value_text_size" />

            <TextView
                android:id="@+id/dashboardGValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:padding="@dimen/page_card_padding"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/page_value_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/dashboardNavigationSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:background="@color/card_panel_bg"
            android:padding="@dimen/page_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_status_text_size" />

        <TextView
            android:id="@+id/dashboardHvacSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:background="@color/card_panel_bg"
            android:padding="@dimen/page_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_status_text_size" />
    </LinearLayout>
</ScrollView>
