<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/page_card_gap">

        <!-- Title -->
        <TextView
            android:id="@+id/dashboardPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_dashboard_badge"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/page_title_text_size"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top Row: Speed, Gear/Battery, Power -->
        <!-- Speed Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/speedCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_section_gap"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/page_card_padding"
            app:layout_constraintTop_toBottomOf="@id/dashboardPageTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/middleColumn"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintHorizontal_chainStyle="spread_inside">

            <TextView
                android:id="@+id/speedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/page_label_speed"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/page_label_text_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/dashboardSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_micro_gap"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/page_speed_text_size"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/speedLabel"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/dashboardImuValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_micro_gap"
                android:textColor="@color/accent_amber"
                android:textSize="@dimen/page_status_text_size"
                app:layout_constraintTop_toBottomOf="@id/dashboardSpeedValue"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Middle Column (Gear & Battery) -->
        <LinearLayout
            android:id="@+id/middleColumn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/page_card_gap"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/speedCard"
            app:layout_constraintEnd_toStartOf="@+id/rightColumn"
            app:layout_constraintTop_toTopOf="@id/speedCard"
            app:layout_constraintBottom_toBottomOf="@id/speedCard"
            app:layout_constraintWidth_percent="0.25">

            <!-- Gear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_gear"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/dashboardGearValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Battery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/page_card_gap"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_battery"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/dashboardBatteryValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column (Power) -->
        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/page_card_gap"
            app:layout_constraintStart_toEndOf="@id/middleColumn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/speedCard"
            app:layout_constraintBottom_toBottomOf="@id/speedCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:id="@+id/dashboardPowerValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_blue"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: G-Force, Summaries -->
        <!-- G-Force -->
        <LinearLayout
            android:id="@+id/gForceCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="@dimen/page_card_padding"
            app:layout_constraintTop_toBottomOf="@id/speedCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/summaryColumn"
            app:layout_constraintWidth_percent="0.45">

            <com.example.vehicle_mountedsystem.ui.GForceIndicatorView
                android:id="@+id/dashboardGForceIndicator"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_gravity="center" />
        </LinearLayout>

        <!-- Summaries -->
        <LinearLayout
            android:id="@+id/summaryColumn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/page_card_gap"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/gForceCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/gForceCard"
            app:layout_constraintBottom_toBottomOf="@id/gForceCard">

            <!-- Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:id="@+id/dashboardNavigationSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <!-- HVAC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/page_card_gap"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:id="@+id/dashboardHvacSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
