<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageHvacRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/shell_content_padding"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hvacPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_hvac_badge"
            android:textColor="@color/accent_cyan"
            android:textSize="@dimen/shell_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hvacIrCapabilityMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shell_content_gap"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:text="@string/hvac_ir_capability_local_only"
            android:textColor="@color/accent_amber"
            android:textSize="@dimen/page_status_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shell_content_gap"
            android:orientation="horizontal">

            <!-- Temperature Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shell_content_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/shell_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hvac_temperature_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/hvacTemperatureValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/hvac_temperature_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hvacTemperatureDecrease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/page_card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/hvac_temp_decrease"
                        android:textColor="@color/accent_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hvacTemperatureIncrease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/hvac_temp_increase"
                        android:textColor="@color/accent_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fan Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/shell_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hvac_fan_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/hvacFanValue"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/hvac_temperature_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hvacFanDecrease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/page_card_gap"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/hvac_fan_decrease"
                        android:textColor="@color/accent_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hvacFanIncrease"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/hvac_fan_increase"
                        android:textColor="@color/accent_cyan"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shell_content_gap"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="@dimen/shell_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hvac_mode_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/page_label_text_size" />

            <TextView
                android:id="@+id/hvacModeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_micro_gap"
                android:textColor="@color/accent_blue"
                android:textSize="@dimen/page_value_text_size"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_card_gap"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hvacModeAuto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/page_card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_mode_auto"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacModeCool"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/page_card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_mode_cool"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacModeHeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/page_card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_mode_heat"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacModeDefog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/page_card_gap"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_mode_defog"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacModeFan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_mode_fan"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- AC & Circulation Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/shell_content_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/shell_content_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/shell_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hvac_ac_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/hvacAcState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacAcToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_ac_toggle"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="@dimen/shell_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hvac_circulation_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/hvacCirculationState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hvacCirculationToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_card_gap"
                    android:background="@drawable/bg_card_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/shell_card_padding"
                    android:text="@string/hvac_circulation_toggle"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
