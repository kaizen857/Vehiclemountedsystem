<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageNavigationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/shell_content_padding"
    android:orientation="vertical">

    <TextView
        android:id="@+id/navigationPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/page_navigation_badge"
        android:textColor="@color/accent_blue"
        android:textSize="@dimen/shell_title_text_size"
        android:textStyle="bold" />

    <!-- Enhanced Route Lane Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shell_content_gap"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="@dimen/shell_card_padding">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_nav_panel_height"
            android:background="@color/bg_dark">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:background="@color/accent_cyan" />
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="16dp"
                android:alpha="0.4"
                android:background="@color/accent_blue" />
        </FrameLayout>

        <TextView
            android:id="@+id/navigationRouteCardPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:text="@string/navigation_route_primary"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_status_text_size"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/navigationRouteCardSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_micro_gap"
            android:text="@string/navigation_demo_notice"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/page_status_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/shell_content_gap"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navigationSpeedValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/page_card_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_value_text_size" />

        <TextView
            android:id="@+id/navigationDestinationValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/page_card_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_value_text_size" />

        <TextView
            android:id="@+id/navigationDistanceValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_value_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/page_card_gap"
        android:orientation="horizontal">
        
        <TextView
            android:id="@+id/navigationEtaValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/page_card_gap"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/page_status_text_size" />

        <TextView
            android:id="@+id/navigationImuStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card_rounded"
            android:padding="@dimen/shell_card_padding"
            android:textColor="@color/accent_amber"
            android:textSize="@dimen/page_status_text_size" />
    </LinearLayout>
</LinearLayout>
