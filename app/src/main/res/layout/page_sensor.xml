<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSensorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sensorPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_sensor_badge"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/page_title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sensorTimestampValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_micro_gap"
            android:text="@string/sensor_timestamp_default"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/page_status_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_section_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_accelerometer"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/sensorAccelerometerValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size" />

                <TextView
                    android:id="@+id/sensorAccelerometerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_linear_acceleration"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/sensorLinearAccelerationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size" />

                <TextView
                    android:id="@+id/sensorLinearAccelerationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_gyroscope"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/sensorGyroscopeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size" />

                <TextView
                    android:id="@+id/sensorGyroscopeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_label_rotation_vector"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/sensorRotationVectorValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_value_text_size" />

                <TextView
                    android:id="@+id/sensorRotationVectorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
