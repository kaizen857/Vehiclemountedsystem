<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingsPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/page_settings_badge"
            android:textColor="@color/accent_blue"
            android:textSize="@dimen/page_title_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_section_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notification_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/settingNotificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_panel_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sensor_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/settingSensorStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/page_card_gap"
                android:layout_weight="1"
                android:background="@color/card_panel_alt_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ir_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/settingIrStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_amber"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/card_panel_alt_bg"
                android:orientation="vertical"
                android:padding="@dimen/page_card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_media_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/page_label_text_size" />

                <TextView
                    android:id="@+id/settingMediaStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/page_micro_gap"
                    android:textColor="@color/accent_cyan"
                    android:textSize="@dimen/page_status_text_size" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/page_card_gap"
            android:background="@color/card_panel_bg"
            android:orientation="vertical"
            android:padding="@dimen/page_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_data_source_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/page_label_text_size" />

            <TextView
                android:id="@+id/settingDataSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/page_micro_gap"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/page_status_text_size" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
